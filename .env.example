# =====================================================================
# SIGRE · Variables de entorno
# =====================================================================
# Copia este archivo como backend/.env y llena los valores de tu equipo:
#   copy .env.example backend\.env        (PowerShell / CMD)
# En Render se configuran las mismas variables en Environment.
# NUNCA subas backend/.env a GitHub: ya está en .gitignore.

# ---------- Base de datos PostgreSQL (obligatorias) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigre
# Usuario de la aplicación (no uses postgres).
DB_USER=sigre_app
DB_PASSWORD=
# En tu PC: prefer. En internet (Render u otro servidor con SSL): require.
DB_SSLMODE=prefer

# ---------- Sesiones (obligatoria) ----------
# Clave larga y aleatoria. Créala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Horas que dura una sesión (opcional, 8 por defecto).
JWT_HORAS_SESION=8

# ---------- Correos: código de verificación y recuperar contraseña ----------
# Dirección donde se abren las páginas; arma el enlace del correo de recuperación.
#   En tu PC con Live Server: http://127.0.0.1:5500/frontend
#   Publicado: https://sigre.onrender.com
FRONTEND_URL=http://127.0.0.1:5500/frontend

# Opción A (en tu PC): SMTP de Gmail.
# MAIL_APP_PASSWORD es una "contraseña de aplicación" de Gmail (16 letras, sin
# espacios), creada en https://myaccount.google.com/apppasswords.
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Opción B (en Render, que bloquea el SMTP): Google Apps Script.
# URL de la aplicación web (termina en /exec) y la misma clave guardada en la
# propiedad CLAVE_SIGRE del script (ver backend/apps_script/correos.gs).
# Si MAIL_SCRIPT_URL tiene valor, se usa esta opción en lugar de la A.
MAIL_SCRIPT_URL=
MAIL_SCRIPT_CLAVE=

# ---------- Notificaciones push al celular (opcionales) ----------
# Crea el par de claves con: python backend/push.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:correo-del-proyecto@gmail.com

# ---------- Otras (opcionales) ----------
# Inicio de sesión con Google (el botón está desactivado en la página).
GOOGLE_CLIENT_ID=
# 1 = modo depuración de Flask al ejecutar python backend/app.py (solo en tu PC).
FLASK_DEBUG=1
