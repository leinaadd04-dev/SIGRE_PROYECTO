# Claves locales
.env
**/.env

# Entorno virtual de Python
venv/
**/venv/

# Archivos generados por Python
__pycache__/
**/__pycache__/
*.py[cod]

# Archivos temporales y caché
cache/
**/cache/

# Archivos de Windows
desktop.ini
Thumbs.db

# Redes de calles: el .graphml completo de OpenStreetMap queda solo en tu PC;
# al servidor se suben las versiones livianas (*.json.gz) que crea
# "python backend/rutas.py".
backend/datos_rutas/*.graphml
